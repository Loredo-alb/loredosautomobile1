# Hostinger: Seiten, Gestaltung und Fahrzeugdaten bei jedem Besuch frisch prüfen,
# damit neue Fahrzeuge und Preise sofort sichtbar sind (Fotos dürfen zwischengespeichert werden).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/x-javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# Interne Dateien (Anleitung, Werkzeuge, claude.ai-Fassung) nicht über die Domain ausliefern;
# sie bleiben im GitHub-Repository.
RedirectMatch 404 ^/(README\.md|ANLEITUNG\.md|claude-vorschau\.html|\.gitignore|\.nojekyll|werkzeuge(/.*)?)$
